# ===========================================
# Application Configuration
# ===========================================
APP_NAME=financial_ai_app
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-min-32-chars-change-in-production
API_VERSION=v1

# ===========================================
# TiDB Database Configuration
# ===========================================
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-username
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=finapp
TIDB_SSL_CA=/path/to/ca.pem

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ===========================================
# AI/ML Configuration
# ===========================================

# Groq API (Fast Inference)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# Gemini API (Document Understanding)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.2

# ===========================================
# MCP Configuration
# ===========================================
MCP_SERVER_URL=http://localhost:8001
MCP_API_KEY=your-mcp-api-key
MCP_TIMEOUT=30
ENABLE_MCP=True

# ===========================================
# Email Integration (Gmail API)
# ===========================================
EMAIL_PROVIDER=gmail
GMAIL_CREDENTIALS_PATH=/path/to/gmail-credentials.json
GMAIL_TOKEN_PATH=/path/to/gmail-token.json
EMAIL_OAUTH_CLIENT_ID=your-oauth-client-id
EMAIL_OAUTH_CLIENT_SECRET=your-oauth-secret
EMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ===========================================
# Google Cloud Platform
# ===========================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_CREDENTIALS_PATH=/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloud Storage (for documents)
GCS_BUCKET_NAME=your-bucket-name
GCS_DOCUMENTS_PATH=documents/
GCS_TEMP_PATH=temp/

# ===========================================
# Security & Authentication
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AI_ALLOCATION=True
ENABLE_EMAIL_EXTRACTION=True
ENABLE_AUTO_ALLOCATION=True
ENABLE_DOCUMENT_UPLOAD=True

# ===========================================
# Wage Access Settings
# ===========================================
MAX_WAGE_ADVANCE_PERCENT=50
MIN_DAYS_WORKED=1
ADVANCE_FEE_PERCENT=2.5

